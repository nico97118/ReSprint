# Jira base URL, without trailing slash.
JIRA_BASE_URL=https://your-domain.atlassian.net

# basic: username/email + token/password.
# bearer: PAT bearer token only; JIRA_USERNAME is ignored.
JIRA_AUTH_METHOD=basic
JIRA_USERNAME=prenom.nom
JIRA_API_TOKEN=your-jira-token-or-password

# Worklog source: jira or tempo.
SPRINT_REVIEW_WORKLOG_SOURCE=jira

# Tempo Cloud API token. Required only when SPRINT_REVIEW_WORKLOG_SOURCE=tempo.
TEMPO_API_TOKEN=

# Optional tuning.
SPRINT_REVIEW_DONE_STATUS_CATEGORIES=done
SPRINT_REVIEW_MIN_SECONDS=1

# Optional: for Jira instances where the epic is stored in a custom field.
# Example: customfield_10014
SPRINT_REVIEW_EPIC_FIELD=
